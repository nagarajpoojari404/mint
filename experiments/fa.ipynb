   "source": [
    "from mint.nn.models import Gemma, GemmaConfig\n",
    "cfg = GemmaConfig(\n",
    "    embed_dim=128,\n",
    "    hidden_dim=512,      # about 4x embed_dim\n",
    "    seq_length=64,\n",
    "    vocab_size=50267,    # must match the tokenizer\n",
    "    n_layers=4,\n",
    "    n_heads=2,\n",
    "    n_kv_heads=2,\n",
    "    head_dim=64,         # n_heads * head_dim == embed_dim\n",
    ")"
   ]
  },
  {
